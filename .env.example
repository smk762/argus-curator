# ── Server ───────────────────────────────────────────────────────────
# Host port for the argus-curator FastAPI server (peer to argus-lens :8100).
CURATOR_PORT=8101

# Default mount root that GET /thumb serves from when no scan_id is supplied.
# Mirrors NEXT_PUBLIC_CURATOR_SOURCE_PATH in argus-vision-demo.
CURATOR_SOURCE_PATH=/data/images

# ── State ────────────────────────────────────────────────────────────
# On-disk scan cache (keyed by scan_id) used for pagination + export-by-id.
# Defaults to ~/.cache/argus_curator/scans if unset.
CURATOR_CACHE_DIR=/home/smk/.cache/argus_curator/scans

# ── Handoff (optional) ───────────────────────────────────────────────
# No setting: an export hands its manifest to argus-lens only when the request
# names lens's endpoint in `caption_url` (e.g. http://localhost:8100/caption).

# ── GPU sharing ──────────────────────────────────────────────────────
# One argus GPU job at a time on this host, each waiting for free VRAM
# (argus_cortex.gpu). docker-compose.yaml turns it on (lease); none turns it off.
ARGUS_GPU_COORDINATOR=lease
# Host directory holding the lock. Every argus service on the host (argus-lens
# too) must mount this same directory and use the same lock file in it,
# /run/argus-gpu/argus-gpu.lock inside the container.
ARGUS_GPU_LOCK_DIR=/tmp/argus-gpu
# Longest a model waits for the GPU before the scan fails (seconds).
ARGUS_GPU_LEASE_TIMEOUT_S=300
