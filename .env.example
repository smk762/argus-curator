# ── Server ───────────────────────────────────────────────────────────
# Host port for the argus-curator FastAPI server (peer to argus-lens :8100).
CURATOR_PORT=8101

# Default mount root that GET /thumb serves from when no scan_id is supplied.
# Mirrors NEXT_PUBLIC_CURATOR_SOURCE_PATH in argus-vision-demo.
CURATOR_SOURCE_PATH=/data/images

# ── State ────────────────────────────────────────────────────────────
# On-disk scan cache (keyed by scan_id) used for pagination + export-by-id.
# Defaults to ~/.cache/argus_curator/scans if unset.
CURATOR_CACHE_DIR=/home/smk/.cache/argus_curator/scans

# ── Handoff (optional) ───────────────────────────────────────────────
# No setting: an export hands its manifest to argus-lens only when the request
# names lens's endpoint in `caption_url` (e.g. http://localhost:8100/caption).

# ── GPU sharing ──────────────────────────────────────────────────────
# One argus GPU job at a time on this host, each waiting for free VRAM
# (argus_cortex.gpu). docker-compose.yaml turns it on (lease); none turns it off.
ARGUS_GPU_COORDINATOR=lease
# Host directory holding the lock. Every argus service on the host (argus-lens
# too) must mount this same directory and use the same lock file in it,
# /run/argus-gpu/argus-gpu.lock inside the container.
ARGUS_GPU_LOCK_DIR=/tmp/argus-gpu
# Longest a model waits for the GPU before the scan fails (seconds).
ARGUS_GPU_LEASE_TIMEOUT_S=300
# The argus-iris GPU broker (docs/gpu.md): ARGUS_GPU_COORDINATOR=broker asks iris
# for each lease, as a kind declared in gpu-tenant.yaml. When iris cannot be
# reached (or has no lease routes yet) the lease comes from the fallback.
# ARGUS_GPU_COORDINATOR=broker
# ARGUS_GPU_BROKER_URL=http://<GPU_BROKER_HOST>:8120
# ARGUS_GPU_BROKER_TOKEN=          # the suite's shared caller token; this host's .env only
# ARGUS_GPU_TENANT_MANIFEST=/app/gpu-tenant.yaml   # compose's default
# ARGUS_GPU_BROKER_FALLBACK=lease  # or none

# ── Server ───────────────────────────────────────────────────────────
# DNS names a browser UI reaches this server by, whose same-host writes are
# allowed (comma-separated, no port). IP addresses and localhost need none.
# CURATOR_TRUSTED_HOSTS=<UI_HOSTNAME>

# ── Remote moderation backends (real host/IP goes in your local .env) ──
# ARGUS_CURATOR_NUDENET_URL=http://<LAN_HOST>:8080
# ARGUS_CURATOR_ERAX_URL=http://<LAN_HOST>:8081
# ARGUS_CURATOR_SINGGUARD_URL=http://<AGENT_HOST>:9150

# ── Under-18 rule ──
# frame (default): a MiVOLO age under 18 and any exposure in the frame exclude
# the image. overlap: the exposure must also sit on the young person's box
# (curator's rule up to 0.15.1). Any other value stops the server starting.
# ARGUS_CURATOR_MINOR_EXPOSED=frame

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
