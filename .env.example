# ── The suite file ───────────────────────────────────────────────────
# Values every Argus service on this host shares (the GPU broker's URL and
# token, the suite-wide detector URLs ARGUS_NUDENET_URL, ARGUS_SINGGUARD_URL,
# ARGUS_PUPPET_URL, ...) can live once in the suite file instead of in each
# repo's .env: ~/.config/argus/suite.env, mode 600
# (`python -m argus_cortex.settings --init`). Curator reads it after its own
# environment, so anything set here still wins. For the container, see the
# commented mount in docker-compose.yaml.

# ── Server ───────────────────────────────────────────────────────────
# Host port for the argus-curator FastAPI server (peer to argus-lens :8100).
CURATOR_PORT=8101

# Default mount root that GET /thumb serves from when no scan_id is supplied.
# Mirrors NEXT_PUBLIC_CURATOR_SOURCE_PATH in argus-vision-demo.
CURATOR_SOURCE_PATH=/data/images

# ── State ────────────────────────────────────────────────────────────
# On-disk scan cache (keyed by scan_id) used for pagination + export-by-id.
# Defaults to ~/.cache/argus_curator/scans if unset.
CURATOR_CACHE_DIR=/home/smk/.cache/argus_curator/scans

# ── Handoff (optional) ───────────────────────────────────────────────
# An export hands its manifest to argus-lens only when the request names lens's
# endpoint in `caption_url`, and only to a host listed here, public or not:
# comma-separated `host` (any port) or `host:port`, the same shape as
# argus-lens's LENS_URL_ALLOWED_HOSTS. Empty (the default): the hand-off is off,
# and an export with a caption_url is refused with 400.
# CURATOR_CAPTION_ALLOWED_HOSTS=lens:8100

# ── Uploads ──────────────────────────────────────────────────────────
# Largest single file POST /upload (and a multipart POST /faces) accepts, in MiB.
# A larger one is refused with 413. Default 50.
# CURATOR_MAX_UPLOAD_MB=50

# ── GPU sharing ──────────────────────────────────────────────────────
# The argus-iris GPU broker (docs/gpu.md): the URL and the token are all it
# takes. Curator then asks iris for each lease, as a kind declared in
# gpu-tenant.yaml, which it registers at startup; when iris cannot be reached
# the lease comes from the host lock below. Both can live in the suite file
# instead, shared by every service on the host.
# ARGUS_GPU_BROKER_URL=http://<GPU_BROKER_HOST>:8120
# ARGUS_GPU_BROKER_TOKEN=          # the suite's shared caller token; the suite file or this host's .env only
# Without a broker: uncomment for one argus GPU job at a time on this host, each
# waiting for free VRAM (argus_cortex.gpu). Leave it out when using iris: an
# explicit value wins over the broker URL, the suite file's included. Unset,
# with no broker URL, gates nothing.
# ARGUS_GPU_COORDINATOR=lease
# Host directory holding the lock. Every argus service on the host (argus-lens
# too) must mount this same directory and use the same lock file in it,
# /run/argus-gpu/argus-gpu.lock inside the container.
ARGUS_GPU_LOCK_DIR=/tmp/argus-gpu
# Longest a model waits for the GPU before the scan fails (seconds).
ARGUS_GPU_LEASE_TIMEOUT_S=300

# ── Server ───────────────────────────────────────────────────────────
# DNS names a browser UI reaches this server by, whose same-host writes are
# allowed (comma-separated, no port). IP addresses and localhost need none.
# CURATOR_TRUSTED_HOSTS=<UI_HOSTNAME>

# ── Remote moderation backends (real host/IP goes in your local .env) ──
# argus-retina's shared servers: NudeNet 640m :8130, EraX :8131, watermark :8132.
# Use the host's IP from inside a container: its own hostname may resolve to loopback.
# Each is curator's own name for the server and wins over the suite-wide one
# (ARGUS_NUDENET_URL, ARGUS_ERAX_URL, ARGUS_WATERMARK_URL, ARGUS_SINGGUARD_URL)
# in the suite file. `off` turns a suite-wide server off for curator.
# ARGUS_CURATOR_NUDENET_URL=http://<LAN_HOST>:8130
# ARGUS_CURATOR_ERAX_URL=http://<LAN_HOST>:8131
# ARGUS_CURATOR_WATERMARK_URL=http://<LAN_HOST>:8132
# ARGUS_CURATOR_SINGGUARD_URL=http://<AGENT_HOST>:9150

# ── Body pose (argus-puppet, optional) ──
# On for every scan once set (a scan opts out with pose.enabled=false); never
# fails a scan when puppet is down. See docs/body-pose.md.
# ARGUS_CURATOR_PUPPET_URL=http://<PUPPET_HOST>:8220   # else the suite-wide ARGUS_PUPPET_URL
# ARGUS_CURATOR_PUPPET_WORKERS=2          # puppet admits ARGUS_PUPPET_POSE_CONCURRENCY calls at once
# ARGUS_CURATOR_PUPPET_MAX_SET=5000       # match puppet's ARGUS_PUPPET_MAX_SET_RESULTS

# ── Under-18 rule ──
# frame (default): a MiVOLO age under 18 and any exposure in the frame exclude
# the image. overlap: the exposure must also sit on the young person's box
# (curator's rule up to 0.15.1). Any other value stops the server starting.
# ARGUS_CURATOR_MINOR_EXPOSED=frame

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
